<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/root"
    android:background="#05060a"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <Chronometer
        android:id="@+id/countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#7dd3fc"
        android:textSize="26sp" />

    <!--
        android:text is placeholder only: this layout is also the previewLayout,
        and without it the widget picker shows an empty box. Every render
        overwrites it.
    -->
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Next meeting"
        android:textColor="#e6e8f0"
        android:textSize="16sp" />
</LinearLayout>
