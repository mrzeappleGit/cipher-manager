{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cipherManager",
  "version": "0.2.0-beta.1",
  "identifier": "com.cipher.manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run prepare:bundle"
  },
  "app": {
    "windows": [
      {
        "title": "cipherManager",
        "width": 1440,
        "height": 920,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.claude/cipher-manager/clips/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/serve"
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
